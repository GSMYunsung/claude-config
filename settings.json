{
  "permissions": {
    "allow": [
      "Bash(git push *)",
      "Bash(git clone *)",
      "Bash(npm install *)",
      "Bash(npx tsc *)",
      "Bash(node *)",
      "Bash(npx expo *)",
      "Bash(open *)",
      "Bash(gh api *)",
      "Bash(python3 -m json.tool)"
    ]
  },
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guard-main-push.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/sync-skill-to-repo.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-log.sh"
          }
        ]
      }
    ]
  }
}
